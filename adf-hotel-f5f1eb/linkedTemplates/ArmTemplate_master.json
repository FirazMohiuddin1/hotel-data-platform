{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-hotel-f5f1eb"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sthoteldlf5f1eb.dfs.core.windows.net/"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-hotel-f5f1eb.vault.azure.net/"
		},
		"ls_pms_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://func-hotel-pms-f5f1eb.azurewebsites.net/api/"
		},
		"ls_pms_api_properties_typeProperties_clientId": {
			"type": "string",
			"defaultValue": "adf-pipeline"
		},
		"ls_pms_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-hotel-pms-f5f1eb-centralus.database.windows.net"
		},
		"ls_pms_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "pms"
		},
		"ls_pms_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "pms_reader"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-hotel-f5f1eb_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_pms_api_properties_typeProperties_url": {
						"value": "[parameters('ls_pms_api_properties_typeProperties_url')]"
					},
					"ls_pms_api_properties_typeProperties_clientId": {
						"value": "[parameters('ls_pms_api_properties_typeProperties_clientId')]"
					},
					"ls_pms_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_pms_sql_properties_typeProperties_server')]"
					},
					"ls_pms_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_pms_sql_properties_typeProperties_database')]"
					},
					"ls_pms_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_pms_sql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}